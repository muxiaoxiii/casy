{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Casy",
  "version": "0.1.0",
  "identifier": "top.muxiaoxi.casy",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Casy",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE4QTFEODI3QTBGMDY3MzIKUldReVovQ2dKOWlocUtJSzhENks0UDdjVEtCQWRkeWY5YzlFS0swQkRvKzNmbllacXBsNXhkeVQK",
      "endpoints": [
        "https://muxiaoxi.top/casy/updates/{{target}}/{{arch}}/{{current_version}}"
      ]
    }
  }
}